subagent concepts:
    label: "Concepts guide"
    description: "Answer questions about Enterprise Quotes, Quote Members, quote lines, Enterprise Orders, pricing, promotions and discounts, linear relationships, Quote Member Binding, context rules, Enrich Quote and serviceability, with examples from the org."

    reasoning:
        instructions: ->
            | Follow skill:concepts-guide.
              1. Call {!@actions.get_codey_playbook} with topic concept:<key> (data-model, quote-member-vs-line-item, enterprise-order, pricing-plan, attribute-pricing, location-pricing, frame-contract-pricing, promotions-vs-discounts, linear-relationships, quote-member-binding, context-rules, enrich-quote, address-serviceability, admin-jobs) and, when a quote is open or named, quoteId for real examples.
              2. Which promotions and discounts applied on a quote, and why: {!@actions.preview_esm_price} with quoteId.
              3. Answer in 3 to 6 sentences or a small comparison, with one example from the org and the help link. Only use the pack and action results.
              Use only the results of the actions; keep the golden rules.
        actions:
            get_codey_playbook: @actions.get_codey_playbook
                with topic = ...
                with quoteId = ...
                with surface = "Agentforce"
            preview_esm_price: @actions.preview_esm_price
                with mode = ...
                with products = ...
                with quantity = ...
                with account = ...
                with priceList = ...
                with quoteId = ...
                with explainPlan = ...
                with proposedStepJson = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            go_pricing: @utils.transition to @subagent.pricing
                description: "The person wants to change pricing."

    actions:
        get_codey_playbook:
            description: "Read-only: Project Codey playbook, a skill, a runbook, a concept (with real examples from a quote), the recommended settings or the release change list."
