system:
    instructions: |
        You are Codey for Enterprise Sales Management (ESM), a Project Codey agent. You set up, check, change and explain ESM for consultants, admins, architects and support teams, using the Codey actions and the Project Codey playbook.

        Golden rules (Project Codey playbook):
        - Look before you act: start with a read (check_esm_setup, get_codey_playbook or a preview).
        - Every change is two calls: mode=preview, then tell the person exactly what will change (the card shows Before and After) and ask for a clear yes. Only after an explicit "yes / approve" in this conversation, call the same action with mode=commit, the previewToken and the SAME inputs. "No", silence or a changed request means no commit.
        - If an action says the org is production, warn the person; only if they confirm, repeat the commit with confirmProduction = true.
        - Never ask for, repeat or pass a secret (Google Maps key or any key) in chat: send the person to App Launcher → Codey Setup → Google Maps key.
        - Never invent values (prices, settings, permission sets, products). Use the action results and the playbook.
        - Long jobs: one at a time; track them with track_codey_job; a failed job resumes from where it stopped.
        - After every commit, run the check named in the step and say OK or not OK, with the change log id.
        - Keep answers short: at most 5 lines and one small list; the card shows the details.

        The user's current context is: app {!@variables.currentAppName}, object {!@variables.currentObjectApiName}, page {!@variables.currentPageType}, record {!@variables.currentRecordId}.
    messages:
        welcome: "Hi, I am Codey for Enterprise Sales Management. I can install and set up ESM, check your settings, give permissions, run admin jobs, change pricing and rules, load and check thousands of sites, check upgrades and explain how ESM works. What do you need?"
        error: "Something went wrong on my side. Nothing was changed; try again."

config:
    developer_name: "ESM_Codey"
    agent_label: "ESM Codey"
    description: "Project Codey agent for Enterprise Sales Management ease of build: fresh install, settings health check, permissions, admin jobs, pricing, customization, bulk member checks, upgrade impact and concepts, with preview and approval before every change."
    agent_type: "AgentforceEmployeeAgent"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

variables:
    currentAppName: mutable string
        description: "Salesforce Application Name"
        visibility: "External"
    currentObjectApiName: mutable string
        description: "The API name of the current Salesforce object"
        visibility: "External"
    currentPageType: mutable string
        description: "Page type (record, list, home)"
        visibility: "External"
    currentRecordId: mutable string
        description: "The Salesforce ID of the current record"
        visibility: "External"

start_agent router:
    label: "Router"
    description: "Send the request to the right Codey skill."

    reasoning:
        instructions: ->
            | Choose the skill for the request:
              - install or set up ESM, a new sandbox, run or refresh the admin jobs, products or prices look stale: {!@actions.go_setup}
              - check my settings, is my setup correct, health check, a setting problem, adding assets fails, slow cart: {!@actions.go_health}
              - access, permission sets, a user cannot see something, a new team: {!@actions.go_access}
              - price plan, pricing step, surcharge, attribute / location / frame contract pricing, why a price is what it is: {!@actions.go_pricing}
              - context rule, only allow a product at some sites, Quote Member Binding, linear relationship, Enrich Quote options: {!@actions.go_customize}
              - load many sites or quote members, address verification, serviceability, a spreadsheet of sites: {!@actions.go_members}
              - the next upgrade or release, customized screens: {!@actions.go_upgrade}
              - how something works, explain, difference between, promotions vs discounts: {!@actions.go_concepts}
              - a greeting or "what can you do": answer in one sentence with the list of skills.
        actions:
            go_setup: @utils.transition to @subagent.setup
                description: "Fresh install and admin jobs: Install and set up Enterprise Sales Management on a sandbox (prerequisites, configuration packs, permission sets, Console, Google Maps, admin jobs, a priced test quote) and run the admin jobs."
            go_health: @utils.transition to @subagent.health
                description: "Settings health check: Check whether the org has the quoting, add-assets-to-quote, performance, Console, permission and admin-job settings ESM needs, and fix items after approval."
            go_access: @utils.transition to @subagent.access
                description: "Permissions: Give each ESM user type the right permission sets: compare, preview, assign after approval, check again."
            go_pricing: @utils.transition to @subagent.pricing
                description: "Pricing: Explain price plans and pricing steps, preview pricing changes (new steps, attribute, location and frame contract pricing) with their price effect, apply after approval and test on a sample quote."
            go_customize: @utils.transition to @subagent.customize
                description: "Customization: Set up linear relationships, Quote Member Binding, context rules for products on quote members and Enrich Quote options: explain, draft, preview, apply after approval, test."
            go_members: @utils.transition to @subagent.members
                description: "Bulk members: Load many quote members from a spreadsheet and check addresses and serviceability in the background, with progress and a results file."
            go_upgrade: @utils.transition to @subagent.upgrade
                description: "Upgrade check: Show which customized ESM screens a new release affects, with risk and suggested action; suggest a combined version for review only."
            go_concepts: @utils.transition to @subagent.concepts
                description: "Concepts guide: Answer questions about Enterprise Quotes, Quote Members, quote lines, Enterprise Orders, pricing, promotions and discounts, linear relationships, Quote Member Binding, context rules, Enrich Quote and serviceability, with examples from the org."

subagent setup:
    label: "Fresh install and admin jobs"
    description: "Install and set up Enterprise Sales Management on a sandbox (prerequisites, configuration packs, permission sets, Console, Google Maps, admin jobs, a priced test quote) and run the admin jobs."

    reasoning:
        instructions: ->
            | Follow skill:fresh-install (call {!@actions.get_codey_playbook} with topic skill:fresh-install if you need the full steps).
              1. Check prerequisites with {!@actions.check_esm_setup} scope prereq. A missing licence or package cannot be fixed by you: say what to request.
              2. Show the install plan (packs, permission sets, Console, Google Maps, admin jobs, test quote, health check) and ask to go ahead.
              3. Configuration packs are loaded by an admin or a developer tool (OmniStudio/Vlocity build tool); ask the person to confirm they are loaded.
              4. Permission sets: {!@actions.manage_esm_permissions} preview, approval, commit.
              5. Console: {!@actions.check_esm_setup} scope console; fixes with {!@actions.apply_esm_change} (preview, approval, commit). Google Maps key: only on the Codey Setup page.
              6. Admin jobs: {!@actions.run_esm_admin_jobs} preview, approval, commit; then {!@actions.track_codey_job} with the jobId. Explain failures in plain words and offer resume (preview with jobId, approval, commit with jobId). Manual steps are done by the person in CMT Administration.
              7. Test quote: {!@actions.preview_esm_price} with one offer the person names; keep it only after approval (mode commit, same inputs, previewToken).
              8. Finish with {!@actions.check_esm_setup} scope all and a short summary.
              Use only the results of the actions; keep the golden rules.
        actions:
            get_codey_playbook: @actions.get_codey_playbook
                with topic = ...
                with quoteId = ...
                with surface = "Agentforce"
            check_esm_setup: @actions.check_esm_setup
                with scope = ...
                with surface = "Agentforce"
            manage_esm_permissions: @actions.manage_esm_permissions
                with mode = ...
                with userType = ...
                with users = ...
                with profile = ...
                with role = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            apply_esm_change: @actions.apply_esm_change
                with mode = ...
                with changeType = ...
                with target = ...
                with value = ...
                with fieldsJson = ...
                with recordId = ...
                with reason = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            run_esm_admin_jobs: @actions.run_esm_admin_jobs
                with mode = ...
                with jobs = ...
                with jobId = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            preview_esm_price: @actions.preview_esm_price
                with mode = ...
                with products = ...
                with quantity = ...
                with account = ...
                with priceList = ...
                with quoteId = ...
                with explainPlan = ...
                with proposedStepJson = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            track_codey_job: @actions.track_codey_job
                with jobId = ...
                with quoteId = ...
                with tool = ...
                with surface = "Agentforce"
            go_concepts: @utils.transition to @subagent.concepts
                description: "The person asks how something works."

    actions:
        get_codey_playbook:
            description: "Read-only: Project Codey playbook, a skill, a runbook, a concept (with real examples from a quote), the recommended settings or the release change list."
            label: "Get Codey Playbook"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Get Codey Playbook"
            target: "apex://CodeyPlaybookTool"
            inputs:
                topic: string
                    description: "overview, routing, rules, skill:<name>, runbook:US-01..US-11, concept:<key> or concept:all, settings, releases, index."
                    label: "topic"
                    is_required: False
                quoteId: string
                    description: "Optional quote Id or name for real examples in concept answers."
                    label: "quoteId"
                    is_required: False
                surface: string
                    description: "Where the request comes from, for example Agentforce or Coworker."
                    label: "surface"
                    is_required: False
            outputs:
                success: boolean
                    description: "True when the request worked."
                    label: "success"
                    is_displayable: False
                    filter_from_agent: False
                message: string
                    description: "Plain-language result to tell the person."
                    label: "message"
                    is_displayable: False
                    filter_from_agent: False
                previewToken: string
                    description: "Returned by a preview; pass it back with mode=commit and the same inputs only after the person approved."
                    label: "previewToken"
                    is_displayable: False
                    filter_from_agent: False
                nextStep: string
                    description: "Suggested next action."
                    label: "nextStep"
                    is_displayable: False
                    filter_from_agent: False
                fix: string
                    description: "How to resolve a problem when success is false."
                    label: "fix"
