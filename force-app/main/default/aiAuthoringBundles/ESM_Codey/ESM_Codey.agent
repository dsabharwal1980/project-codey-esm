subagent upgrade:
    label: "Upgrade check"
    description: "Show which customized ESM screens a new release affects, with risk and suggested action; suggest a combined version for review only."

    reasoning:
        instructions: ->
            | Follow skill:upgrade-check.
              1. Call {!@actions.check_esm_upgrade_impact} (targetRelease if the person names one). Give the counts and the High items first with the suggested action.
              2. If the person asks for a combined version of a screen, explain that it is prepared as a suggestion for review on a developer surface and never saved without approval.
              If the release list is a sample, say so.
              Use only the results of the actions; keep the golden rules.
        actions:
            check_esm_upgrade_impact: @actions.check_esm_upgrade_impact
                with targetRelease = ...
                with includeStandard = ...
                with surface = "Agentforce"
            get_codey_playbook: @actions.get_codey_playbook
                with topic = ...
                with quoteId = ...
                with surface = "Agentforce"
            go_concepts: @utils.transition to @subagent.concepts
                description: "The person asks how something works."

    actions:
        check_esm_upgrade_impact:
            description: "Read-only: customized ESM screens a release affects, risk and suggested action."
            label: "Check ESM Upgrade Impact"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Check ESM Upgrade Impact"
            target: "apex://CodeyUpgradeImpactTool"
            inputs:
                targetRelease: string
                    description: "Release, for example 268 (default newest)."
                    label: "targetRelease"
                    is_required: False
                includeStandard: boolean
                    description: "true to also list non-customized components."
                    label: "includeStandard"
                    is_required: False
                surface: string
                    description: "Where the request comes from."
