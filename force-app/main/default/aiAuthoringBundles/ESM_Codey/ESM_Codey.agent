subagent members:
    label: "Bulk members"
    description: "Load many quote members from a spreadsheet and check addresses and serviceability in the background, with progress and a results file."

    reasoning:
        instructions: ->
            | Follow skill:bulk-members.
              1. Read the spreadsheet the person attached and pass its rows as membersCsv (or the file id as contentDocumentId) to {!@actions.check_quote_members_bulk} mode preview with the quote. Report recognised columns, rows to load, duplicates and rows with errors.
              2. Only after an explicit yes: mode commit with previewToken and the same inputs.
              3. Track with {!@actions.track_codey_job}; when completed, give the results file and the counts (valid / partial / invalid, serviceable / not) and the top reasons.
              Use only the results of the actions; keep the golden rules.
        actions:
            check_quote_members_bulk: @actions.check_quote_members_bulk
                with mode = ...
                with quoteId = ...
                with membersCsv = ...
                with contentDocumentId = ...
                with checks = ...
                with onlyUnchecked = ...
                with jobId = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            track_codey_job: @actions.track_codey_job
                with jobId = ...
                with quoteId = ...
                with tool = ...
                with surface = "Agentforce"
            get_codey_playbook: @actions.get_codey_playbook
                with topic = ...
                with quoteId = ...
                with surface = "Agentforce"
            go_concepts: @utils.transition to @subagent.concepts
                description: "The person asks how something works."

    actions:
        check_quote_members_bulk:
            description: "Load many quote members from a spreadsheet and check addresses and serviceability in the background, with a results file."
            label: "Check Quote Members Bulk"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Check Quote Members Bulk"
            target: "apex://CodeyBulkCheckTool"
            inputs:
                mode: string
                    description: "preview (default), commit after approval, or status."
                    label: "mode"
                    is_required: False
                quoteId: string
                    description: "Enterprise Quote Id or name."
                    label: "quoteId"
                    is_required: True
                membersCsv: string
                    description: "CSV text with a header row (name/site, street/address, city, state, postal code, country)."
                    label: "membersCsv"
                    is_required: False
                contentDocumentId: string
                    description: "ContentDocument Id (069...) of an attached CSV."
                    label: "contentDocumentId"
                    is_required: False
                checks: string
                    description: "address, serviceability, or none."
                    label: "checks"
