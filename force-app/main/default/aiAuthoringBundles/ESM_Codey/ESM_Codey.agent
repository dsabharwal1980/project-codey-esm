subagent pricing:
    label: "Pricing"
    description: "Explain price plans and pricing steps, preview pricing changes (new steps, attribute, location and frame contract pricing) with their price effect, apply after approval and test on a sample quote."

    reasoning:
        instructions: ->
            | Follow skill:pricing.
              1. Explain the current plan with {!@actions.preview_esm_price} explainPlan true; one line per step (concept:pricing-plan).
              2. Work out the change and the fields needed; ask for missing values, never invent amounts. For attribute, location or frame contract pricing read the concept with {!@actions.get_codey_playbook}.
              3. Preview: {!@actions.apply_esm_change} changeType pricingPlanStep (fieldsJson) AND {!@actions.preview_esm_price} with sample products and proposedStepJson to show the price before and after. Nothing is saved.
              4. After an explicit yes: commit the apply_esm_change with the same inputs and previewToken. If prices are cached, run {!@actions.run_esm_admin_jobs} jobs pricing (preview, approval, commit).
              5. Test: {!@actions.preview_esm_price} with the same sample; offer undo (changeType undo, target the change log) if the result is wrong.
              To explain why a quote has its prices, promotions and discounts, call {!@actions.preview_esm_price} with quoteId.
              Use only the results of the actions; keep the golden rules.
        actions:
            preview_esm_price: @actions.preview_esm_price
                with mode = ...
                with products = ...
                with quantity = ...
                with account = ...
                with priceList = ...
                with quoteId = ...
                with explainPlan = ...
                with proposedStepJson = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            apply_esm_change: @actions.apply_esm_change
                with mode = ...
                with changeType = ...
                with target = ...
                with value = ...
                with fieldsJson = ...
                with recordId = ...
                with reason = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            run_esm_admin_jobs: @actions.run_esm_admin_jobs
                with mode = ...
                with jobs = ...
                with jobId = ...
                with previewToken = ...
                with confirmProduction = ...
                with surface = "Agentforce"
            get_codey_playbook: @actions.get_codey_playbook
                with topic = ...
                with quoteId = ...
                with surface = "Agentforce"
            go_concepts: @utils.transition to @subagent.concepts
                description: "The person asks how something works."

    actions:
        preview_esm_price:
            description: "Price a sample quote without saving (every step, promotions, discounts); explain the pricing plan or an existing quote; simulate a new pricing step."
            label: "Preview ESM Price"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Preview ESM Price"
            target: "apex://CodeyPricePreviewTool"
            inputs:
                mode: string
                    description: "preview (default) or commit to keep a test quote after approval."
                    label: "mode"
                    is_required: False
                products: string
                    description: "Comma-separated product names, codes or Ids."
                    label: "products"
                    is_required: False
                quantity: number
                    description: "Quantity per product."
                    label: "quantity"
                    is_required: False
                account: string
                    description: "Account Id or name."
                    label: "account"
                    is_required: False
                priceList: string
                    description: "Price list name."
                    label: "priceList"
                    is_required: False
                quoteId: string
                    description: "Existing quote to explain (read-only)."
                    label: "quoteId"
                    is_required: False
                explainPlan: boolean
                    description: "true to list the pricing plan steps."
                    label: "explainPlan"
                    is_required: False
                proposedStepJson: string
                    description: "Pricing plan step JSON to simulate."
                    label: "proposedStepJson"
                    is_required: False
                previewToken: string
                    description: "Token from the preview, for commit."
                    label: "previewToken"
                    is_required: False
                confirmProduction: boolean
                    description: "true only if the person confirmed in production."
                    label: "confirmProduction"
                    is_required: False
                surface: string
                    description: "Where the request comes from."
                    label: "surface"
                    is_required: False
